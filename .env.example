# Existing website Supabase connection; retain until the migration is reviewed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Central CBDEVS Supabase project (server-side only).
# Set these only after configuring Vercel for the verified central project.
CBDEVS_CENTRAL_SUPABASE_URL=https://rpfupihdsqxprhptxypv.supabase.co
CBDEVS_CENTRAL_SUPABASE_SERVICE_ROLE_KEY=

# Optional, server-side only. Secret used to hash visitor IPs for rate limiting.
# Falls back to the service-role key when unset. Generate with: openssl rand -hex 32
CBDEVS_INQUIRY_HASH_SECRET=

# Optional. Extra origins allowed to post the contact form (comma-separated),
# e.g. when the site is served from a custom domain and a vercel.app domain.
CBDEVS_WEB_ALLOWED_ORIGINS=
